{
  "config": {
    "nats_url": "<NATS_URL>",
    "agents_dir": "<CACHE_DIR>/agents",
    "cache_dir": "<CACHE_DIR>",
    "edge": "<EDGE_ADDR>"
  },
  "stores": {
    "worker_path": "<CACHE_DIR>/worker.db",
    "control_plane_path": "<CACHE_DIR>/control-plane.db",
    "projection_path": "<CACHE_DIR>/projection.db",
    "legacy_events_db": null,
    "initialised": true
  },
  "daemon": null,
  "daemon_error": "could not reach the edge at <EDGE_ADDR>: Connection refused (os error #)"
}
