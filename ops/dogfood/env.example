# Template for the dogfood instance's SECRETS: install as
# ~/fq-dogfood/.secrets/env (chmod 600). It is the `env_file` of the
# daemon, the watcher and the scheduler in compose.yml (ADR-0035) — a
# plain KEY=VALUE file. Compose does no shell expansion: no quotes are
# needed and no `$(command)` works, so every secret is written out.
#
# Secrets only. A setting that is not a secret — the repository the
# watcher follows, its poll interval, a build-cache bound — is declared
# in compose.yml under the service's `environment:`, in git, and lands
# with the deploy. A value written here under one of those names is
# outranked by compose.yml's and does nothing; delete it.
#
# One file for three processes, so a variable one of them reads is set
# for all of them. The dashboard is deliberately NOT one of them: it gets
# .secrets/dashboard.env (template: dashboard.env.example) with only its
# three edge settings, so the one web-facing process never holds a
# provider key, GH_TOKEN or the broker token (#545).

# LLM provider keys — one per provider declared in fqd.toml. A provider
# key missing here fails the daemon at startup (the pricing guarantee),
# not silently at invocation time. The dogfood instance's fqd.toml
# declares `[providers.anthropic]` and `[providers.openrouter]`, so both
# keys are required; drop a line only when its provider leaves fqd.toml.
ANTHROPIC_API_KEY=sk-ant-REPLACE-ME
OPENROUTER_API_KEY=sk-or-v1-REPLACE-ME

# GitHub auth for the watcher and for agents' `gh pr create`. A literal
# token: there is no launcher to run `gh auth token` for you any more,
# so rotation means editing this file and `docker compose up -d` (only a
# recreate re-reads an env_file). #402 wants the groomer on its own
# issues-only token; until then this one serves every role.
GH_TOKEN=ghp_REPLACE-ME

# The instance broker's token (#542): one value, three consumers, three
# variables. Generate it with `openssl rand -hex 32`; the broker side is
# `.secrets/nats-auth.conf` holding `authorization { token: "<value>" }`
# (README, "Broker token").
#
#   - The daemon reads it from the variable fqd.toml names under
#     `[nats] token_env` — name FQ_NATS_TOKEN there. It never goes in the
#     daemon's URL (the image's FQ_NATS_URL=nats://nats:4222 is printed in
#     the banner, the log and the startup event, and the daemon refuses
#     one that carries a credential, #540).
#   - The Go adapters take it as URL userinfo, each through its own
#     variable. The broker is `nats:4222` on the stack's network and is
#     not published on the host at all.
#
# All three, or none: an adapter left on the token-less default cannot
# connect once the broker requires the token.
FQ_NATS_TOKEN=REPLACE-ME
GHW_NATS_URL=nats://REPLACE-ME@nats:4222
FQCRON_NATS_URL=nats://REPLACE-ME@nats:4222
