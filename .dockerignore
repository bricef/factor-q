# Docker build context = the repo root: the Dockerfile is passed with
# `-f services/fq-runtime/Dockerfile` from `just docker-build`. Keep the
# context lean — nothing is compiled in-image (ADR-0035), so the only
# thing the build reads from the context is the staged binaries in
# dist/bin/ plus the nats-server pin and checksums.

# Build output, except the staged binaries `just docker-stage` writes.
**/target/
dist/
!dist/bin/

# Repo-local tooling, scratch, and VCS.
.git/
.claude/
.tools/
.ci-timings

# Editor and OS junk.
.idea/
.vscode/
*.swp
.DS_Store
